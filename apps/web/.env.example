# Vote Wallet - Citizen Web Portal Environment Configuration

# Next.js App
NEXT_PUBLIC_APP_NAME="Vote Wallet"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# Microservices URLs
NEXT_PUBLIC_API_GATEWAY_URL="http://localhost:8080"
NEXT_PUBLIC_AUTH_SERVICE_URL="http://localhost:3001"
NEXT_PUBLIC_VOTING_SERVICE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_SERVICE_URL="http://localhost:3002"
NEXT_PUBLIC_FACE_SERVICE_URL="http://localhost:8000"

# Cryptographic and Verification Settings
NEXT_PUBLIC_ENABLE_SIMULATED_CAMERA=false
NEXT_PUBLIC_SESSION_TIMEOUT_SECONDS=600
NEXT_PUBLIC_MAX_OTP_COUNTDOWN_SECONDS=120
