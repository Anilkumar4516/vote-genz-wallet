PORT=3004
DEBUG=false

# Voter Registry Database (STRICTLY READ-ONLY access to encrypted face template vectors only)
VOTER_REGISTRY_DB_HOST=localhost
VOTER_REGISTRY_DB_PORT=5432
VOTER_REGISTRY_DB_USER=face_template_readonly
VOTER_REGISTRY_DB_PASS=secure_face_read_password
VOTER_REGISTRY_DB_NAME=vote_wallet_identity
VOTER_REGISTRY_DB_POOL_MIN=2
VOTER_REGISTRY_DB_POOL_MAX=10

# Redis for short-lived challenge tokens & liveness session store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Biometric Template In-Memory Decryption Key (AES-256)
TEMPLATE_DECRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Service-to-service shared authentication secret
INTERNAL_SERVICE_SECRET=sec_face_srv_internal_auth_token_88192

# Biometric InsightFace & ArcFace Thresholds
FACE_MATCH_SIMILARITY_THRESHOLD=0.82
LIVENESS_CONFIDENCE_THRESHOLD=0.88
CHALLENGE_TTL_SECONDS=180
