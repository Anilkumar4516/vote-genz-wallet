PORT=3001
NODE_ENV=development

# 1. Voter Registry Database (Strictly READ-ONLY credentials)
VOTER_REGISTRY_DB_HOST=localhost
VOTER_REGISTRY_DB_PORT=5432
VOTER_REGISTRY_DB_USER=voter_registry_readonly
VOTER_REGISTRY_DB_PASS=secure_ro_password
VOTER_REGISTRY_DB_NAME=vote_wallet_identity
VOTER_REGISTRY_DB_POOL_MAX=20

# 2. Redis Session, OTP & Rate Limit Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 3. Security & JWT Session
JWT_SECRET=super_secret_auth_jwt_key_min_32_bytes_random
JWT_EXPIRES_IN=15m
SESSION_TTL_SECONDS=900

# 4. SMS Gateway Providers (MSG91 & Twilio)
SMS_PROVIDER=msg91 # options: msg91 | twilio | mock
MSG91_AUTH_KEY=mock_msg91_auth_key
MSG91_TEMPLATE_ID=mock_template_id
MSG91_SENDER_ID=VOTEIN
TWILIO_ACCOUNT_SID=mock_twilio_account_sid
TWILIO_AUTH_TOKEN=mock_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# 5. Lockout & Administrative Security Alert
MAX_FAILED_ATTEMPTS=3
LOCKOUT_DURATION_SECONDS=1800 # 30 minutes
ADMIN_ALERT_WEBHOOK_URL=http://localhost:3003/admin/audit-log
