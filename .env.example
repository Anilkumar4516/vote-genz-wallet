# ==========================================
# Vote Wallet Production Environment Configuration
# ==========================================

# Application Port & Mode
PORT=3000
NODE_ENV=production

# Cryptographic Master Key (Must be 32+ characters in production)
ELECTION_SECRET=your-32-character-ultra-secure-master-key-here

# PostgreSQL Database Configuration
DATABASE_URL=postgres://postgres:postgres_secure_pass@localhost:5432/vote_wallet
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres_secure_pass
PGDATABASE=vote_wallet
PG_MAX_CONNECTIONS=50
DATABASE_SSL=false

# Redis Cluster & Redis Streams Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Asynchronous Voting Worker Stream Configuration
VOTE_STREAM_KEY=election:1:ballot_stream
VOTE_CONSUMER_GROUP=voting_workers
VOTE_BATCH_SIZE=100

# Rate Limiting Parameters
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SEC=60
RATE_LIMIT_VOTE_MAX=5
RATE_LIMIT_VOTE_WINDOW_SEC=60
