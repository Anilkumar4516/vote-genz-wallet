{
  "title": "Vote Wallet: Election Day Operations",
  "timezone": "browser",
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Total Turnout Count (Voter Participations)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(voter_participation_total)",
          "legendFormat": "Total Votes Cast"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 100000 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Vote Ingestion Rate (RPS)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 10, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "rate(ballot_cast_requests_total[1m])",
          "legendFormat": "Ballots/sec"
        }
      ]
    },
    {
      "id": 3,
      "title": "Ballot Sealing Latency (P95 & P99)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ballot_encryption_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P95 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ballot_encryption_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99 Latency"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active Biometric & OTP Sessions",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "redis_active_sessions_count",
          "legendFormat": "Active Sessions in Redis"
        }
      ]
    },
    {
      "id": 5,
      "title": "Redis Streams Ingestion Buffer Lag",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "redis_stream_unprocessed_ballots",
          "legendFormat": "Queue Depth"
        }
      ]
    }
  ]
}
