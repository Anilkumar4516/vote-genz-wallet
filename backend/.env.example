# Application Environment Configuration
APP_NAME=vote-wallet-backend
ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Security & Secrets
SECRET_KEY=change-this-in-production-to-a-very-long-and-random-secret-key-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ELECTION_MASTER_SECRET=virtual-election-vote-wallet-master-key-2026

# Database (PostgreSQL 16 / PgBouncer or SQLite local fallback)
DATABASE_URL=postgresql+psycopg2://postgres:postgres_secure_pass@localhost:5432/vote_wallet
# For local zero-dependency testing without PostgreSQL:
# DATABASE_URL=sqlite:///./vote_wallet.sqlite3
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis Cache, Streams & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_STREAM_KEY=elections:ballot_stream
REDIS_CONSUMER_GROUP=voting_workers

# Rate Limits (Requests per window)
RATE_LIMIT_AUTH=10
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_VOTE=5
RATE_LIMIT_VOTE_WINDOW=60
