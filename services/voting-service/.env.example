PORT=3002
NODE_ENV=development

# 1. Voter Registry Database (Strictly INSERT participation record ONLY)
VOTER_REGISTRY_DB_HOST=localhost
VOTER_REGISTRY_DB_PORT=5432
VOTER_REGISTRY_DB_USER=voter_participation_insert_only
VOTER_REGISTRY_DB_PASS=secure_insert_password
VOTER_REGISTRY_DB_NAME=vote_wallet_identity
VOTER_REGISTRY_DB_POOL_MAX=25

# 2. Ballot Box Database (Encrypted ballots, Merkle tree nodes, receipts - separate credentials)
BALLOT_BOX_DB_HOST=localhost
BALLOT_BOX_DB_PORT=5432
BALLOT_BOX_DB_USER=ballot_box_user
BALLOT_BOX_DB_PASS=secure_ballot_password
BALLOT_BOX_DB_NAME=vote_wallet_ballot_box
BALLOT_BOX_DB_POOL_MAX=50

# Redis Cache & Message Stream
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Encryption & KMS
BALLOT_ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
KMS_PROVIDER=local
KMS_KEY_ID=alias/vote-wallet-ballot-key
AWS_REGION=us-east-1

# Internal service authentication for administrative tallying & auditing
INTERNAL_SERVICE_SECRET=sec_srv_inter_comm_token_99210
ADMIN_AUDIT_SERVICE_URL=http://localhost:3003/admin/audit-log
JWT_SECRET=super_secure_voting_service_jwt_secret_token_min_32_chars
